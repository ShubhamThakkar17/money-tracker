# Google Sheet used as the database (see README)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON. Keep the quotes; \n line breaks are fine.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password to open the app
APP_PASSWORD=
# Optional extra secret for session cookies
AUTH_SECRET=
